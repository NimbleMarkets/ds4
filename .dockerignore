# Keep the Docker build context source-only. Host build artifacts would
# otherwise invalidate the COPY layer cache on every local make, and
# foreign-format objects (e.g. macOS Mach-O .o) break Linux links inside
# the containers. Mirrors .gitignore plus .git itself.
.git
**/*.o
**/*.dSYM
**/__pycache__
**/*.pyc
**/.*.swp
.DS_Store
ds4
ds4-server
ds4-bench
ds4-eval
ds4-agent
ds4_cpu
ds4_native
ds4_agent_test
ds4_server_test
ds4_test
libds4.dylib
libds4.so
libds4.dll
ds4flash.gguf
gguf
core
core.*
misc
